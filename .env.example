# Runtime environment variables
APP_URL = "http://localhost:5173"

# The single redirect_url registered in Untappd's app settings (must always
# be the production callback — Untappd only supports one). Must be the same
# value here and in production. Set this to your actual production URL.
UNTAPPD_REDIRECT_URL = "https://your-domain.example/auth/untappd/callback"

# A session is force-closed once it's both older than MAX_SESSION_AGE_HOURS
# and idle (no activity) for longer than MAX_SESSION_IDLE_TIME_HOURS.
MAX_SESSION_AGE_HOURS = 12
MAX_SESSION_IDLE_TIME_HOURS = 1

# Generate with e.g. `openssl rand -hex 32`
SESSION_SECRET = ""
TOTP_SECRET = ""

DATABASE_FILE_NAME = "data.db"
DATABASE_PATH = "./app/database"

DRIZZLE_GATEWAY_MASTERPASS = ""

ADMIN_USER_EMAILS = "" # Comma-separated list of admin emails

# SMTP configuration
SMTP_HOST = ""
SMTP_PORT = 465
SMTP_USER = ""
SMTP_PASS = ""
SMTP_FROM = "HopRank <hoprank@your-domain.example>"

# Untappd API credentials
UNTAPPD_CLIENT_ID = ""
UNTAPPD_CLIENT_SECRET = ""

# Build-time environment variables
VITE_WS_URL = "http://localhost:4000"

# Untappd Algolia search credentials
VITE_ALGOLIA_APP_ID = ""
VITE_ALGOLIA_API_K = ""

VITE_UMAMI_SRC_URL = ""
VITE_UMAMI_WEBSITE_ID = ""

VITE_LATEST_COMMIT_HASH = ""
VITE_LATEST_COMMIT_MESSAGE = ""
